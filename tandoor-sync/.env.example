# Keep this file private. Copy it to .env and supply real values.
KPTNCOOK_API_KEY=
KPTNCOOK_ACCESS_TOKEN=
# Stable, non-secret account label used to prevent accidental history reuse.
KPTNCOOK_ACCOUNT_ID=
KPTNCOOK_API_URL=https://mobile.kptncook.com
KPTNCOOK_LANG=de
KPTNCOOK_STORE=de
# Set true only after verifying the installed client/API returns the full account inventory.
KPTNCOOK_FAVORITES_COMPLETE=false

TANDOOR_URL=https://tandoor.example.com
TANDOOR_TOKEN=
# The cookbook/space ID in Tandoor.
TANDOOR_SPACE_ID=

SYNC_INTERVAL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=30
